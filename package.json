{
  "name": "intl-datepicker",
  "version": "0.4.1",
  "description": "Framework-agnostic multi-calendar datepicker Web Component powered by Intl.DateTimeFormat",
  "type": "module",
  "main": "dist/intl-datepicker.js",
  "module": "dist/intl-datepicker.js",
  "types": "dist/intl-datepicker.d.ts",
  "customElements": "dist/custom-elements.json",
  "exports": {
    ".": {
      "types": "./dist/intl-datepicker.d.ts",
      "import": "./dist/intl-datepicker.js"
    },
    "./full": {
      "types": "./dist/full.d.ts",
      "import": "./dist/full.js"
    },
    "./calendars/persian": {
      "types": "./dist/calendars/calendar.d.ts",
      "import": "./dist/calendars/persian.js"
    },
    "./calendars/islamic": {
      "types": "./dist/calendars/calendar.d.ts",
      "import": "./dist/calendars/islamic.js"
    },
    "./calendars/hebrew": {
      "types": "./dist/calendars/calendar.d.ts",
      "import": "./dist/calendars/hebrew.js"
    },
    "./calendars/buddhist": {
      "types": "./dist/calendars/calendar.d.ts",
      "import": "./dist/calendars/buddhist.js"
    },
    "./calendars/japanese": {
      "types": "./dist/calendars/calendar.d.ts",
      "import": "./dist/calendars/japanese.js"
    },
    "./calendars/indian": {
      "types": "./dist/calendars/calendar.d.ts",
      "import": "./dist/calendars/indian.js"
    },
    "./calendars/ethiopic": {
      "types": "./dist/calendars/calendar.d.ts",
      "import": "./dist/calendars/ethiopic.js"
    },
    "./calendars/coptic": {
      "types": "./dist/calendars/calendar.d.ts",
      "import": "./dist/calendars/coptic.js"
    },
    "./calendars/roc": {
      "types": "./dist/calendars/calendar.d.ts",
      "import": "./dist/calendars/roc.js"
    },
    "./labels/fa": {
      "types": "./dist/labels/labels.d.ts",
      "import": "./dist/labels/fa.js"
    },
    "./labels/ar": {
      "types": "./dist/labels/labels.d.ts",
      "import": "./dist/labels/ar.js"
    },
    "./labels/he": {
      "types": "./dist/labels/labels.d.ts",
      "import": "./dist/labels/he.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    }
  },
  "sideEffects": [
    "./dist/intl-datepicker.js",
    "./dist/full.js",
    "./dist/calendars/*.js",
    "./dist/labels/*.js",
    "./src/intl-datepicker.js",
    "./src/full.js",
    "./src/calendars/*.js",
    "./src/labels/*.js"
  ],
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && cem analyze",
    "build:demo": "vite build --config vite.demo.config.js",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "prepublishOnly": "npm test && npm run build",
    "test:browser": "vitest run --project browser",
    "typecheck": "tsc -p tsconfig.types.json",
    "size": "node scripts/size.mjs",
    "analyze": "cem analyze"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.0"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@js-temporal/polyfill": "^0.5.1",
    "@types/react": "^19.3.0",
    "@vitest/browser": "^3.2.4",
    "jsdom": "^26.1.0",
    "playwright": "^1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "terser": "^5.46.2",
    "typescript": "^7.0.2",
    "vite": "^6.3.1",
    "vitest": "^3.1.1"
  },
  "peerDependencies": {
    "react": ">=17.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "keywords": [
    "datepicker",
    "calendar",
    "persian",
    "jalali",
    "islamic",
    "hebrew",
    "web-component",
    "intl",
    "i18n",
    "multi-calendar"
  ],
  "license": "MIT",
  "author": "Navid Kashani",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eramhq/intl-datepicker.git"
  },
  "homepage": "https://github.com/eramhq/intl-datepicker#readme",
  "bugs": {
    "url": "https://github.com/eramhq/intl-datepicker/issues"
  }
}
